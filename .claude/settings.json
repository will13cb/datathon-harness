{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make board)",
      "Bash(make baseline)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws s3 ls:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./.aws/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"", "timeout": 15 }]
      }
    ]
  }
}
